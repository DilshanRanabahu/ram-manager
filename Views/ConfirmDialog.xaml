<Window x:Class="RamManager.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}" UseLayoutRounding="True">
    <Border Margin="24" Width="420" Padding="24" CornerRadius="14"
            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource DangerSoftBrush}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource DangerBrush}"
                               HorizontalAlignment="Center" FontSize="17"/>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="14,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20" Margin="0,16,0,24"
                       Foreground="{StaticResource SubtleTextBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" MinWidth="96" IsCancel="True"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource DangerSolidButton}" MinWidth="116"
                        Margin="10,0,0,0" Click="OnConfirm"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
