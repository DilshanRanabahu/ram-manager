<Window x:Class="RamManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RamManager.Views"
        Title="RAM Manager"
        Width="1180" Height="800" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True">

    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22,16,16">

                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,30">
                    <Image Source="/Assets/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RAM Manager" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Memory optimizer" Style="{StaticResource Caption}" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Memory widget -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16" CornerRadius="12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Memory" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding Dashboard.LoadText}" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" Foreground="{Binding Dashboard.StatusBrush}"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ThinBar}" Margin="0,10,0,10"
                                     Maximum="100" Value="{Binding Dashboard.LoadPercent, Mode=OneWay}"
                                     Foreground="{Binding Dashboard.StatusBrush}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14">
                            <Run Text="{Binding Dashboard.AvailableText, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                            <Run Text="available"/>
                        </TextBlock>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding QuickCleanCommand}"
                                HorizontalAlignment="Stretch" Padding="12,9"
                                ToolTip="Flush modified pages, purge the standby cache and combine identical pages">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding QuickCleanLabel}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"
                               Margin="12,0,0,8"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Dashboard"
                                 Command="{Binding NavigateCommand}" CommandParameter="{Binding Dashboard}"
                                 IsChecked="{Binding IsDashboardActive, Mode=OneWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Processes"
                                 Command="{Binding NavigateCommand}" CommandParameter="{Binding Processes}"
                                 IsChecked="{Binding IsProcessesActive, Mode=OneWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                 Command="{Binding NavigateCommand}" CommandParameter="{Binding SettingsPage}"
                                 IsChecked="{Binding IsSettingsActive, Mode=OneWay}"/>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Not elevated warning (only in development builds) -->
            <Border Grid.Row="0" Margin="32,20,32,0" Padding="14,10" CornerRadius="10"
                    Background="#26F2A93B" BorderBrush="#55F2A93B" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Not running as administrator — memory cleaning is unavailable. Restart the app as administrator."
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="32,26,32,24">
                <Grid x:Name="DashboardPage" Visibility="{Binding IsDashboardActive, Converter={StaticResource BoolToVis}}">
                    <views:DashboardView DataContext="{Binding Dashboard}"/>
                </Grid>
                <Grid x:Name="ProcessesPage" Visibility="{Binding IsProcessesActive, Converter={StaticResource BoolToVis}}">
                    <views:ProcessesView DataContext="{Binding Processes}"/>
                </Grid>
                <Grid x:Name="SettingsPage" Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVis}}">
                    <views:SettingsView DataContext="{Binding SettingsPage}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ Toast ============ -->
        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"
                Padding="16,12" CornerRadius="10" MaxWidth="640"
                Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                         From="14" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding ToastGlyph}" Foreground="{Binding ToastBrush}"
                           FontSize="15" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ToastMessage}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
