<UserControl x:Class="RamManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RamManager.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,6,0">

            <!-- ============ Header ============ -->
            <DockPanel Margin="0,0,0,22">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="18,10"
                        VerticalAlignment="Center" Command="{Binding Main.QuickCleanCommand}"
                        ToolTip="Flush modified pages, purge the standby cache and combine identical pages">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Main.QuickCleanLabel}"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Live overview of your system memory" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </DockPanel>

            <!-- ============ Load + overview ============ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Gauge -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Memory load" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" CornerRadius="10" Padding="10,3" Background="{Binding StatusSoftBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusBrush}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <Grid Width="196" Height="196" Margin="0,18,0,0" HorizontalAlignment="Center">
                            <controls:RingGauge Value="{Binding LoadPercent}" Thickness="16"
                                                TrackBrush="{StaticResource ControlBrush}" ValueBrush="{Binding StatusBrush}"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}">
                                    <Run Text="{Binding LoadNumber, Mode=OneWay}" FontSize="50" FontWeight="SemiBold"/><Run Text="%" FontSize="20" Foreground="{StaticResource SubtleTextBrush}"/>
                                </TextBlock>
                                <TextBlock Text="in use" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}" Margin="0,-6,0,0">
                            <Run Text="{Binding UsedText, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                            <Run Text="of"/>
                            <Run Text="{Binding TotalText, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Overview -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Overview" Style="{StaticResource SectionTitle}"/>

                        <UniformGrid Columns="4" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Used" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding UsedText}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="{Binding LoadText, StringFormat={}{0} of total}" Style="{StaticResource Caption}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Available" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding AvailableText}" Style="{StaticResource StatValue}" Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="Ready for apps" Style="{StaticResource Caption}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel ToolTip="Committed memory: what programs have reserved, backed by RAM and the page file">
                                <TextBlock Text="Committed" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding CommitText}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="{Binding CommitLimitText}" Style="{StaticResource Caption}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Total" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding TotalText}" Style="{StaticResource StatValue}"/>
                                <TextBlock Text="Usable RAM" Style="{StaticResource Caption}" FontSize="11"/>
                            </StackPanel>
                        </UniformGrid>

                        <Border Style="{StaticResource Divider}" Margin="0,20,0,18"/>

                        <TextBlock Text="Memory composition" Style="{StaticResource SectionTitle}" FontSize="13"/>
                        <controls:MemoryCompositionBar Height="14" Margin="0,12,0,16"
                                                       InUse="{Binding InUse}" Modified="{Binding Modified}"
                                                       Standby="{Binding Standby}" Free="{Binding Free}"
                                                       InUseBrush="{StaticResource InUseBrush}"
                                                       ModifiedBrush="{StaticResource ModifiedBrush}"
                                                       StandbyBrush="{StaticResource StandbyBrush}"
                                                       FreeBrush="{StaticResource FreeBrush}"
                                                       TrackBrush="{StaticResource ControlBrush}"/>

                        <UniformGrid Columns="4">
                            <StackPanel ToolTip="Used by processes, drivers and the operating system">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource InUseBrush}"/>
                                    <TextBlock Text="In use" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding InUseText}" FontSize="15" FontWeight="SemiBold" Margin="18,4,0,0"/>
                            </StackPanel>
                            <StackPanel ToolTip="Changed pages that must be written to disk before the memory can be reused">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource ModifiedBrush}"/>
                                    <TextBlock Text="Modified" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ModifiedText}" FontSize="15" FontWeight="SemiBold" Margin="18,4,0,0"/>
                            </StackPanel>
                            <StackPanel ToolTip="Cached data. Windows reuses it instantly when apps need memory">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource StandbyBrush}"/>
                                    <TextBlock Text="Standby (cache)" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding StandbyText}" FontSize="15" FontWeight="SemiBold" Margin="18,4,0,0"/>
                            </StackPanel>
                            <StackPanel ToolTip="Completely unused memory">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource FreeBrush}"/>
                                    <TextBlock Text="Free" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FreeText}" FontSize="15" FontWeight="SemiBold" Margin="18,4,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ History + top apps ============ -->
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Height="300">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock Text="Usage history" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding HistoryCaption}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <controls:HistoryChart Margin="0,14,0,0"
                                               Values="{Binding History}" Capacity="{Binding Capacity}"
                                               LineBrush="{StaticResource AccentBrush}"
                                               GridBrush="{StaticResource StrokeBrush}"
                                               LabelBrush="{StaticResource MutedTextBrush}"/>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Height="300">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Top apps by memory" Style="{StaticResource SectionTitle}"/>
                            <Button Style="{StaticResource LinkButton}" Content="View all" HorizontalAlignment="Right"
                                    Command="{Binding Main.NavigateCommand}" CommandParameter="{Binding Main.Processes}"/>
                        </DockPanel>
                        <Grid>
                            <TextBlock Text="Loading processes…"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopApps.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding TopApps}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="22" Height="22" HorizontalAlignment="Left">
                                                <TextBlock x:Name="Fallback" Style="{StaticResource Glyph}" Text="&#xECAA;"
                                                           FontSize="16" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
                                                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11"
                                                               Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <ProgressBar Style="{StaticResource ThinBar}" Height="4" Margin="0,6,0,0"
                                                             Value="{Binding Fraction, Mode=OneWay}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding MemoryText}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" MinWidth="60" TextAlignment="Right"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                <Setter TargetName="Fallback" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============ Optimize ============ -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Main.LastCleanText}" Style="{StaticResource Caption}" DockPanel.Dock="Right" VerticalAlignment="Bottom"/>
                <StackPanel>
                    <TextBlock Text="Optimize" Style="{StaticResource SectionTitle}" FontSize="16"/>
                    <TextBlock Text="Run individual memory operations. Quick clean runs the three safe ones together."
                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Actions}" Focusable="False" Margin="-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="6,0" Padding="18">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="{Binding AccentSoftBrush}">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="17"
                                                   Foreground="{Binding AccentBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="8" Padding="8,3"
                                            Background="{Binding TagSoftBrush}">
                                        <TextBlock Text="{Binding TagText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TagBrush}"/>
                                    </Border>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Margin="0,14,0,0" Padding="16,6" Command="{Binding RunCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="11" Margin="0,0,8,0"/>
                                        <TextBlock Text="Run"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
