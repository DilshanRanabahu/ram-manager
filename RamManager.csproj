<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RamManager</RootNamespace>
    <AssemblyName>RamManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>RAM Manager</Product>
    <Version>1.1.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Keep the footprint small: no background GC thread for a tiny UI app -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- DPI awareness is set in the manifest on purpose (WPF app; WinForms is only used for the tray icon) -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- dotnet build -p:NoAdmin=true  -> runs without UAC prompt (limited mode, for development) -->
  <PropertyGroup Condition="'$(NoAdmin)' == 'true'">
    <ApplicationManifest>app.dev.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, MessageBox, etc. Only WPF is imported globally. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
